# Copy to .env for local development only. Never commit real values.

# Auth.js (NEXTAUTH_* names are accepted as aliases of AUTH_*)
AUTH_URL=http://localhost:3000
AUTH_SECRET=GENERATE_WITH_openssl_rand_-base64_32

# PostgreSQL
DATABASE_URL=postgres://user:password@localhost:5432/urlaubsplaner

# Trusted public hostnames for writes behind a reverse proxy (comma-separated)
ALLOWED_ORIGINS=localhost:3000

# Optional legacy Keycloak sign-in for accounts created before local accounts.
# Only offered when all three values are set.
# AUTH_KEYCLOAK_ID=urlaubsplaner
# AUTH_KEYCLOAK_SECRET=YOUR_KEYCLOAK_CLIENT_SECRET
# AUTH_KEYCLOAK_ISSUER=https://auth.example.com/realms/your-realm
